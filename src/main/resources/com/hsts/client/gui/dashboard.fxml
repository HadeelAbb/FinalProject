<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hsts.client.gui.DashboardWindow" spacing="12" style="-fx-padding: 20;">

    <Label fx:id="welcomeLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label fx:id="roleLabel" style="-fx-text-fill: #555;"/>

    <VBox spacing="8" style="-fx-padding: 20 0 0 0;">
        <Button fx:id="questionsButton" onAction="#handleQuestions" text="Manage question bank" maxWidth="Infinity"/>
        <Button fx:id="buildExamButton" onAction="#handleBuildExam" text="Build an exam" maxWidth="Infinity"/>
        <Button fx:id="gradeExamsButton" onAction="#handleGradeExams" text="Grade submitted exams" maxWidth="Infinity"/>
        <Button fx:id="approveExamsButton" onAction="#handleApproveExams" text="Approve pending exams" maxWidth="Infinity"/>
        <Button fx:id="takeExamButton" onAction="#handleTakeExam" text="Take an exam" maxWidth="Infinity"/>
        <Button fx:id="myResultsButton" onAction="#handleMyResults" text="View my results" maxWidth="Infinity"/>
    </VBox>

    <Label fx:id="errorLabel" style="-fx-text-fill: red;"/>
</VBox>
