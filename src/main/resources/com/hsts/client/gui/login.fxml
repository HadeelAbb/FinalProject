<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" minHeight="400.0" minWidth="600.0" prefHeight="400.0" prefWidth="600.0" spacing="20.0" style="             -fx-background-color:                 linear-gradient(                     to bottom,                     #d1eaf0 0%,                     #5b8ab5 70%,                     #1a2a44 100%                 );             -fx-background-radius: 25;             -fx-border-radius: 25;             -fx-border-color: #ececec;             -fx-border-width: 1;             -fx-effect:                 dropshadow(                     gaussian,                     rgba(5, 1, 78, 0.65),                     10,                     0.5,                     0,                     0                 );         " stylesheets="@app.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hsts.client.gui.LoginWindow">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <!-- Login title -->
    <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="40.0" prefWidth="300.0" text=" HSTS Login " textAlignment="CENTER" textFill="#1f4e79">

        <font>
            <Font name="Segoe UI Bold" size="22.0" />
        </font>

        <effect>
            <DropShadow height="36.57" radius="19.73" spread="0.11" width="44.36">

                <color>
                    <Color red="0.4106" green="0.6983" blue="0.8421" />
                </color>
            </DropShadow>
        </effect>

        <VBox.margin>
            <Insets bottom="15.0" />
        </VBox.margin>
    </Label>

    <!-- Username field: ID preserved from P0 -->
    <TextField fx:id="usernameField" maxWidth="220.0" prefHeight="38.0" promptText="Username" style="                 -fx-background-radius: 20;                 -fx-border-radius: 20;                 -fx-padding: 0 15 0 15;                 -fx-background-color: white;                 -fx-border-color: rgba(255, 255, 255, 0.4);                 -fx-border-width: 1;             ">

        <font>
            <Font name="System Italic" size="13.0" />
        </font>
    </TextField>

    <!-- Password field: ID preserved from P0 -->
    <PasswordField fx:id="passwordField" maxWidth="220.0" prefHeight="38.0" promptText="Password" style="                 -fx-background-radius: 20;                 -fx-border-radius: 20;                 -fx-padding: 0 15 0 15;                 -fx-background-color: white;                 -fx-border-color: rgba(255, 255, 255, 0.4);                 -fx-border-width: 1;             ">

        <font>
            <Font name="System Italic" size="13.0" />
        </font>
    </PasswordField>

    <!-- Login button: ID and action preserved from P0 -->
    <Button fx:id="loginButton" defaultButton="true" mnemonicParsing="false" onAction="#onLoginButtonClick" prefHeight="35.0" prefWidth="130.0" style="                 -fx-background-color:                     linear-gradient(                         to bottom,                         #368cda,                         #1f4e79                     );                 -fx-background-radius: 20;                 -fx-border-radius: 20;                 -fx-cursor: hand;             " text="Login" textFill="WHITE">

        <font>
            <Font name="Segoe UI Bold" size="14.0" />
        </font>

        <effect>
            <DropShadow height="20.0" offsetY="2.0" radius="10.0" spread="0.1" width="20.0">

                <color>
                    <Color red="0.2" green="0.2" blue="0.2" opacity="0.3" />
                </color>
            </DropShadow>
        </effect>

        <VBox.margin>
            <Insets top="5.0" />
        </VBox.margin>
    </Button>

    <!-- Error label: ID preserved from P0 -->
    <Label fx:id="errorLabel" alignment="CENTER" maxWidth="1.7976931348623157E308" prefHeight="30.0" textAlignment="CENTER" textFill="#ffffff" wrapText="true">

        <font>
            <Font name="Segoe UI Bold" size="14.0" />
        </font>
    </Label>

</VBox>
