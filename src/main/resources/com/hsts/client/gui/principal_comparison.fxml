<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hsts.client.gui.PrincipalComparisonWindow"
            styleClass="body-pane" stylesheets="@app.css">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-bar" style="-fx-padding: 14 24 14 24;">
            <Label text="Comparison Reports" styleClass="top-bar-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button fx:id="backButton" onAction="#handleBack" text="Back to Dashboard" styleClass="nav-button"/>
            <Button fx:id="logoutButton" onAction="#handleLogout" text="Log out" styleClass="nav-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="10" style="-fx-padding: 12 16 12 16;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Compare by:" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="reportTypeCombo" prefWidth="140"/>
                <ComboBox fx:id="filterCombo" prefWidth="220"/>
                <Button fx:id="generateButton" onAction="#handleGenerate" text="Generate Report" styleClass="action-button"/>
                <Button fx:id="refreshButton" onAction="#handleRefresh" text="Refresh" styleClass="action-button"/>
            </HBox>

            <Label text="Comparison" style="-fx-font-weight: bold;"/>
            <TableView fx:id="comparisonTable" prefHeight="220" VBox.vgrow="ALWAYS"/>

            <Label text="Mean / Median Comparison" style="-fx-font-weight: bold;"/>
            <BarChart fx:id="comparisonChart" prefHeight="220" animated="false" VBox.vgrow="ALWAYS">
                <xAxis>
                    <CategoryAxis label="Exam"/>
                </xAxis>
                <yAxis>
                    <NumberAxis label="Grade" minorTickCount="0" autoRanging="false" lowerBound="0" upperBound="100"/>
                </yAxis>
            </BarChart>

            <Label fx:id="distributionLabel" text="Selected Exam Distribution" style="-fx-font-weight: bold;"/>
            <BarChart fx:id="distributionChart" legendVisible="false" prefHeight="200" animated="false" VBox.vgrow="ALWAYS">
                <xAxis>
                    <CategoryAxis label="Grade Range"/>
                </xAxis>
                <yAxis>
                    <NumberAxis label="Students" minorTickCount="0"/>
                </yAxis>
            </BarChart>

            <Label fx:id="errorLabel" styleClass="status-error" wrapText="true"/>
        </VBox>
    </center>

</BorderPane>