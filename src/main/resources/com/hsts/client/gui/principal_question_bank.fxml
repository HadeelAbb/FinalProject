<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hsts.client.gui.PrincipalQuestionBankWindow"
            styleClass="body-pane" stylesheets="@app.css">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-bar" style="-fx-padding: 14 24 14 24;">
                <Label text="Question Bank — Read Only" styleClass="top-bar-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="backButton" onAction="#handleBack" text="Back to Dashboard" styleClass="nav-button"/>
                <Button fx:id="logoutButton" onAction="#handleLogout" text="Log out" styleClass="nav-button"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 12 16 8 16;">
                <Label text="Course:"/>
                <ComboBox fx:id="courseCombo" prefWidth="160"/>
                <Label text="Topic:"/>
                <TextField fx:id="topicField" promptText="contains..." prefWidth="140"/>
                <Label text="Difficulty:"/>
                <ComboBox fx:id="difficultyCombo" prefWidth="110"/>
                <Button fx:id="searchButton" onAction="#handleSearch" text="Search" styleClass="action-button"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <HBox spacing="12" style="-fx-padding: 8 16 12 16;">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Questions" style="-fx-font-weight: bold;"/>
                <TableView fx:id="questionTable" prefHeight="480"/>
            </VBox>
            <VBox spacing="6" prefWidth="420">
                <Label text="Selected Question" style="-fx-font-weight: bold;"/>
                <TextArea fx:id="detailArea" wrapText="true" editable="false" prefHeight="280"/>
                <Label text="Illustration (read-only)" style="-fx-text-fill: #555;"/>
                <ImageView fx:id="illustrationView" fitWidth="400" fitHeight="180" preserveRatio="true"/>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <Label fx:id="errorLabel" styleClass="status-error" wrapText="true" style="-fx-padding: 0 16 12 16;"/>
    </bottom>

</BorderPane>
