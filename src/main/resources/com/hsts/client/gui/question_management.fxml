<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hsts.client.gui.QuestionManagementWindow"
            styleClass="body-pane" stylesheets="@app.css">

    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="top-bar" style="-fx-padding: 14 24 14 24;">
                <Label text="Question Bank" styleClass="top-bar-title" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="backButton" onAction="#handleBack" text="Back to Dashboard" styleClass="nav-button"/>
                <Button fx:id="logoutButton" onAction="#handleLogout" text="Log out" styleClass="nav-button"/>
            </HBox>
            <VBox spacing="6" style="-fx-padding: 12 10 10 10;">
                <Label fx:id="loggedInLabel" style="-fx-text-fill: #555;"/>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Search topic:"/>
                    <TextField fx:id="searchTopicField" promptText="topic contains..." prefWidth="160"/>
                    <Label text="Difficulty:"/>
                    <ComboBox fx:id="searchDifficultySelector" promptText="Any"/>
                    <Label text="Course:"/>
                    <ComboBox fx:id="searchCourseSelector" promptText="Any"/>
                    <Button fx:id="searchButton" onAction="#handleSearchQuestions" text="Search" styleClass="action-button"/>
                    <Button fx:id="newButton" onAction="#handleNewQuestion" text="New Question" styleClass="action-button"/>
                </HBox>
            </VBox>
        </VBox>
    </top>

    <left>
        <ListView fx:id="questionListView" prefWidth="320" BorderPane.alignment="CENTER"/>
    </left>

    <center>
        <VBox spacing="8" style="-fx-padding: 10;">
            <Label text="Question text:"/>
            <TextArea fx:id="questionTextField" prefHeight="60" wrapText="true"/>

            <Label text="Instructions:"/>
            <TextArea fx:id="instructionsField" prefHeight="40" wrapText="true"/>

            <Label text="Answers (select the correct one):"/>
            <GridPane hgap="8" vgap="6">
                <RadioButton fx:id="answer1Correct" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="answer1Field" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="320"/>

                <RadioButton fx:id="answer2Correct" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="answer2Field" GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="320"/>

                <RadioButton fx:id="answer3Correct" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="answer3Field" GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="320"/>

                <RadioButton fx:id="answer4Correct" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="answer4Field" GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="320"/>
            </GridPane>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Difficulty:"/>
                <ComboBox fx:id="difficultySelector"/>
                <Label text="Topic:"/>
                <TextField fx:id="topicField" prefWidth="140"/>
                <Label text="Course:"/>
                <ComboBox fx:id="courseSelector"/>
            </HBox>

            <Label fx:id="versionLabel" style="-fx-text-fill: #555;"/>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Illustration (optional PNG/JPG):"/>
                <Button fx:id="browseImageButton" onAction="#handleBrowseImage" text="Choose image..."/>
                <Label fx:id="imageFileLabel" text="No illustration" style="-fx-text-fill: #555;"/>
            </HBox>
            <ImageView fx:id="illustrationView" fitWidth="320" fitHeight="180" preserveRatio="true"/>

            <HBox spacing="10">
                <Button fx:id="saveButton" onAction="#handleSaveQuestion" text="Save" styleClass="primary-button"/>
                <Button fx:id="deleteButton" onAction="#handleDeleteQuestion" text="Delete" styleClass="action-button"/>
            </HBox>

            <Label fx:id="statusLabel" styleClass="status-success" wrapText="true"/>
            <Label fx:id="errorLabel" styleClass="status-error" wrapText="true"/>
        </VBox>
    </center>

</BorderPane>
